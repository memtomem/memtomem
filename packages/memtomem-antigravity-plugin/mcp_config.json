{
  "mcpServers": {
    "memtomem": {
      "command": "uvx",
      "args": [
        "--python",
        "3.12",
        "--from",
        "memtomem[onnx]==0.7.2",
        "memtomem-server"
      ],
      "env": {
        "MEMTOMEM_TOOL_MODE": "core",
        "MEMTOMEM_EXTRA_TOOLS": "mem_update_coverage",
        "ORT_DISABLE_TELEMETRY": "1"
      }
    }
  }
}
