{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "memtomem": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--python",
        "3.12",
        "--from",
        "memtomem[onnx]==0.6.8",
        "memtomem-server"
      ],
      "env": {
        "MEMTOMEM_TOOL_MODE": "core",
        "ORT_DISABLE_TELEMETRY": "1"
      }
    }
  }
}
